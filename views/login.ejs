<%- include('partials/head', { title: 'Log in' }) %>
<section class="card narrow">
  <h1>Log in</h1>
  <% if (typeof error !== 'undefined') { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/login" class="form">
    <label>Phone number<input name="phone" inputmode="numeric" value="<%= phone %>" required autofocus></label>
    <label>Password<input name="password" type="password" required></label>
    <button class="btn">Log in</button>
  </form>
  <p class="muted">New here? <a href="/register">Join the center</a></p>
</section>
<%- include('partials/foot') %>
