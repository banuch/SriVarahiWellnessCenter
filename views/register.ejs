<%- include('partials/head', { title: 'Join' }) %>
<section class="card narrow">
  <h1>Join Sri Varahi Wellness Center</h1>
  <% if (typeof error !== 'undefined') { %><div class="alert error"><%= error %></div><% } %>
  <% if (sponsor && sponsor.status === 'active' && sponsor.role !== 'customer' && sponsor.role !== 'admin') { %>
    <div class="alert info">You are joining under <strong><%= sponsor.name %></strong> (<%= roleLabel(sponsor) %>).</div>
  <% } %>
  <form method="post" action="/register" class="form">
    <label>Full name<input name="name" value="<%= form.name || '' %>" required></label>
    <label>Phone number (10 digits)<input name="phone" inputmode="numeric" pattern="\d{10}" value="<%= form.phone || '' %>" required></label>
    <label>Email (optional)<input name="email" type="email" value="<%= form.email || '' %>"></label>
    <label>Password (min 6 characters)<input name="password" type="password" minlength="6" required></label>
    <fieldset class="roles">
      <legend>Join as</legend>
      <label class="radio"><input type="radio" name="role" value="customer" <%= form.role !== 'coach' ? 'checked' : '' %>>
        <span><strong>Customer</strong><br><small>Use our wellness services</small></span></label>
      <label class="radio"><input type="radio" name="role" value="coach" <%= form.role === 'coach' ? 'checked' : '' %>>
        <span><strong>Coach</strong><br><small>Refer customers and coaches, grow to Supervisor</small></span></label>
    </fieldset>
    <label>Referral code (optional)<input name="refCode" value="<%= form.refCode || '' %>" placeholder="e.g. SVAB12CD" style="text-transform:uppercase"></label>
    <button class="btn">Join</button>
  </form>
  <p class="muted">Already a member? <a href="/login">Log in</a></p>
</section>
<%- include('partials/foot') %>
