<%# locals: member, sponsor, team, directCustomers, target %>
<section class="cards three stats">
  <div class="card">
    <h3><%= member.name %></h3>
    <p><span class="badge <%= member.role %>"><%= roleLabel(member) %></span>
       <% if (member.status === 'blocked') { %><span class="badge grey">Blocked</span><% } %></p>
    <p class="muted">📞 <%= member.phone %><% if (member.email) { %><br>✉️ <%= member.email %><% } %></p>
    <p class="muted">Joined under: <%= sponsor ? sponsor.name : 'Sri Varahi Wellness Center' %></p>
  </div>
  <% if (member.role === 'coach') { %>
    <div class="card">
      <h3>Promotion to Supervisor</h3>
      <p class="big"><%= directCustomers %> / <%= target %></p>
      <div class="progress"><span style="width: <%= Math.min(100, Math.round(directCustomers / target * 100)) %>%"></span></div>
      <p class="muted"><%= Math.max(0, target - directCustomers) %> more direct customer(s) needed to become Supervisor L1.</p>
    </div>
  <% } else if (member.role === 'supervisor') { %>
    <div class="card">
      <h3>Supervisor level</h3>
      <p class="big">L<%= member.level || 1 %></p>
      <p class="muted"><% if (member.promoted_at) { %>Supervisor since <%= member.promoted_at.slice(0, 10) %>.<% } %> Higher levels are given by the center.</p>
    </div>
  <% } else { %>
    <div class="card"><h3>Member</h3><p class="muted">Thank you for being part of our wellness family.</p></div>
  <% } %>
  <% if (member.role !== 'customer') { %>
    <div class="card">
      <h3>Team summary</h3>
      <ul class="plain">
        <li>Supervisors: <strong><%= team.supervisorLines.reduce((s, l) => s + l.members.length, 0) %></strong>
          <% if (team.supervisorLines.length) { %>(<%= team.supervisorLines.map(l => 'Line ' + l.line + ': ' + l.members.length).join(', ') %>)<% } %></li>
        <li>My coaches: <strong><%= team.coaches.length %></strong></li>
        <li>My customers: <strong><%= team.customers.length %></strong></li>
        <li>Whole team: <strong><%= team.total %></strong></li>
      </ul>
    </div>
  <% } %>
</section>
