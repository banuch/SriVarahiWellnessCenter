<%- include('partials/head', { title: 'Add customer' }) %>
<section class="card narrow">
  <h1>Add a customer</h1>
  <% if (typeof error !== 'undefined') { %><div class="alert error"><%= error %></div><% } %>
  <% if (currentUser.role === 'admin') { %>
    <p class="muted">Enter a Coach's or Supervisor's referral code to add the customer to their team, or leave it empty to add them directly under the center.</p>
  <% } else { %>
    <div class="alert info">The customer will join <strong>your team</strong> and count toward your direct customers.</div>
  <% } %>
  <form method="post" action="/customers" class="form">
    <label>Full name<input name="name" value="<%= form.name || '' %>" required></label>
    <label>Phone number (10 digits)<input name="phone" inputmode="numeric" pattern="\d{10}" value="<%= form.phone || '' %>" required></label>
    <label>Email (optional)<input name="email" type="email" value="<%= form.email || '' %>"></label>
    <label>Password for the customer (min 6 characters)<input name="password" type="text" minlength="6" autocomplete="off" required></label>
    <% if (currentUser.role === 'admin') { %>
      <label>Add under referral code (optional)<input name="refCode" value="<%= form.refCode || '' %>" placeholder="e.g. SVAB12CD" style="text-transform:uppercase"></label>
    <% } %>
    <p class="muted">Give the customer their phone number and this password so they can log in.</p>
    <button class="btn">Add customer</button>
  </form>
  <p class="muted"><a href="<%= currentUser.role === 'admin' ? '/admin' : '/dashboard' %>">Cancel</a></p>
</section>
<%- include('partials/foot') %>
